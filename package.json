    "test": "pnpm --filter grist-widget-sdk test && pnpm typecheck:examples && pnpm --filter www build",
    "build:www": "pnpm --filter www build",
    "build:widgets-manifest": "node scripts/build-widgets-manifest.mjs",
    "typecheck:examples": "pnpm build:widgets-manifest && node scripts/typecheck-examples.mjs",
    "check:agents-md": "node scripts/check-agents-md.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
