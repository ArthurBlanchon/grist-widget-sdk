{
  "name": "grist-widget-sdk-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "turbo dev",
