{
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "declaration": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "isolatedModules": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
  }