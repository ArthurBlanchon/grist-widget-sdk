{
  "name": "grist-widget-sdk",
  "version": "0.6.0",
  "description": "React hooks and helpers for Grist custom widgets",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurBlanchon/grist-widget-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ArthurBlanchon/grist-widget-sdk/issues"
  },
  "homepage": "https://gristwidgets.com",
  "keywords": [
    "grist",
    "widget",
    "custom-widget",
    "react",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./app": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./actions": {
      "import": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      },
      "require": {
        "types": "./dist/actions.d.cts",
        "default": "./dist/actions.cjs"
      }
    },
    "./emulator": {
      "import": {
        "types": "./dist/emulator.d.ts",
        "default": "./dist/emulator.js"
      },
      "require": {
        "types": "./dist/emulator.d.cts",
        "default": "./dist/emulator.cjs"
      }
    },
    "./emulator/testing": {
      "import": {
        "types": "./dist/emulator/testing.d.ts",
        "default": "./dist/emulator/testing.js"
      },
      "require": {
        "types": "./dist/emulator/testing.d.cts",
        "default": "./dist/emulator/testing.cjs"
      }
    },
    "./tsconfig/app.json": "./tsconfig/app.json",
    "./tsconfig/node.json": "./tsconfig/node.json"
  },
  "files": [
    "dist",
    "tsconfig",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp -f ../../LICENSE ./LICENSE",
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run --project unit --project emulator --project docs",
    "test:unit": "vitest --run --project unit",
    "test:emulator": "vitest --run --project emulator --passWithNoTests",
    "test:coverage": "vitest --run --project unit --project emulator --coverage",
    "bench": "vitest run --project bench",
    "bench:update": "BENCH_UPDATE=1 vitest run --project bench",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "grist-plugin-api": "^0.0.1",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "grain-rpc": "^0.1.7",
    "zod": "^4.6.7"
  }
}
